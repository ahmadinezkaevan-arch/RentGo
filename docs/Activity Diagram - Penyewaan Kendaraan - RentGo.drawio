        <mxCell id="n99" parent="1" value="Serah terima hanya bila lunas 100% &amp; dokumen terverifikasi; bawa identitas asli. Keterlambatan mengembalikan kendaraan dikenakan biaya tambahan." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9B2;strokeColor=#d6b656;align=left;fontSize=10;size=14;" vertex="1"><mxGeometry x="1370" y="3449.0" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="n100" parent="1" value="" source="n43" target="n99" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n101" parent="1" value="Ketentuan refund pembatalan oleh pelanggan:&lt;br&gt;&gt;7 hari sebelum sewa: 100%&lt;br&gt;3-7 hari: 90%&lt;br&gt;&lt;3 hari: 75%&lt;br&gt;Pada tanggal sewa / tidak datang: 0%" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9B2;strokeColor=#d6b656;align=left;fontSize=10;size=14;" vertex="1"><mxGeometry x="1370" y="2921.0" width="250" height="110" as="geometry"/></mxCell>
