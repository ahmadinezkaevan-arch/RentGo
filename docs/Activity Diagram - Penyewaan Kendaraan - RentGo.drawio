        <mxCell id="n97" parent="1" value="Diskon durasi sewa:&lt;br&gt;1-3 hari: 0%&lt;br&gt;4-7 hari: 5%&lt;br&gt;8-10 hari: 10%&lt;br&gt;11-14 hari: 15%&lt;br&gt;&gt;14 hari: 20%" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9B2;strokeColor=#d6b656;align=left;fontSize=10;size=14;" vertex="1"><mxGeometry x="1370" y="1953.0" width="250" height="110" as="geometry"/></mxCell>
